NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/buildsphere?replicaSet=rs0
# Generate a unique random value of at least 32 characters for each environment.
JWT_ACCESS_SECRET=replace_with_a_unique_random_secret_at_least_32_characters
# Keep false unless behind a trusted reverse proxy; otherwise set a hop count.
TRUST_PROXY=false
# auto detects transaction support; set required for production replica-set/sharded deployments.
OUTBOX_TRANSACTION_MODE=required

# Document object storage: filesystem remains the backward-compatible default.
# Set to "s3" to use an S3-compatible private bucket (AWS S3, MinIO, etc.).
DOCUMENT_STORAGE_DRIVER=filesystem
# Used only by the filesystem driver; mount a durable private volume in production.
DOCUMENT_STORAGE_DIR=./var/private-documents

# Required only when DOCUMENT_STORAGE_DRIVER=s3. Use a private bucket with public access blocked.
S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
S3_REGION=us-east-1
S3_BUCKET=buildsphere-private-documents
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional for temporary credentials (STS/assumed roles).
S3_SESSION_TOKEN=
# ClamAV daemon is required; uploads fail closed if the scanner is unavailable.
CLAMD_HOST=127.0.0.1
CLAMD_PORT=3310
