NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/buildsphere
# Generate a unique random value of at least 32 characters for each environment.
JWT_ACCESS_SECRET=replace_with_a_unique_random_secret_at_least_32_characters
# Keep false unless behind a trusted reverse proxy; otherwise set a hop count.
TRUST_PROXY=false
# auto detects transaction support; set required for production replica-set/sharded deployments.
OUTBOX_TRANSACTION_MODE=auto

# Private document storage: mount a persistent volume at this path in production.
DOCUMENT_STORAGE_DIR=/var/lib/buildsphere/documents
# ClamAV daemon is required; uploads fail closed if the scanner is unavailable.
CLAMD_HOST=127.0.0.1
CLAMD_PORT=3310
