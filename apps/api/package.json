{
  "name": "@buildsphere/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "npm run build && node --test dist/config/security.test.js dist/modules/intelligence/intelligence.rules.test.js dist/modules/collaboration/collaboration.access.test.js dist/modules/collaboration/collaboration.mongo.test.js dist/modules/delivery/documents.mongo.test.js dist/modules/commercial/commercial.schemas.test.js dist/modules/delivery/document-storage.test.js dist/readiness.test.js",
    "migrate:financial-decimals": "node scripts/migrate-financial-decimals.mjs",
    "migrate:document-files-to-s3": "node scripts/migrate-document-files-to-s3.mjs"
  },
  "dependencies": {
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^18.0.10",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "mongoose": "^8.19.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "^4.1.12",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "express-rate-limit": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "@aws-sdk/client-s3": "^3.883.0"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^26.6.6",
    "tsx": "^4.20.6",
    "@types/cookie-parser": "^1.4.9",
    "@types/jsonwebtoken": "^9.0.10"
  }
